# Copy this file to .env and fill in real values.
# Never commit the real .env file — it's already git-ignored.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Job Tracker API"
DEBUG=False
ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Server — only used for local runs. On Render, PORT is injected
# automatically (see render.yaml) and the Dockerfile's CMD reads it directly;
# you don't need to set these two locally either unless you want non-defaults.
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local dev (SQLite, file lives in backend/):
DATABASE_URL=sqlite:///./job_tracker.db

# Render Postgres (copy the "External Database URL" from your Render
# Postgres instance and change the scheme from postgres:// to
# postgresql:// — SQLAlchemy 2.x requires the explicit dialect name):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# CORS — comma-separated list of origins allowed to call this API.
# Include your deployed Vercel URL(s) here in production.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# ---------------------------------------------------------------------------
# File Upload
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880
