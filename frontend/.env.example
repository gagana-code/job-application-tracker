# Copy this file to .env for local development.
# Vite only exposes variables prefixed with VITE_ to client code.

# Local backend (uvicorn / docker-compose):
VITE_API_URL=http://localhost:8000/api/v1

# .env.production (already committed) points at the deployed Render backend
# instead — Vite picks that file automatically for `npm run build`.
